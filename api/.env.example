# mock = paiements simulés en local (aucune clé nécessaire)
#   numéro finissant par 0 -> succès, par 1 -> échec (après 6 s)
# sandbox / live = vrais appels Fapshi
FAPSHI_MODE=mock
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=

CORS_ORIGINS=http://localhost:3000

# Lecture des photos (IA Google Gemini, offre gratuite : https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OCR_PROVIDER=mock  -> texte simulé (tests)
