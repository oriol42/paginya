# mock = paiements simulés en local (aucune clé nécessaire)
#   numéro finissant par 0 -> succès, par 1 -> échec (après 6 s)
# sandbox / live = vrais appels Fapshi
FAPSHI_MODE=mock
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=

CORS_ORIGINS=http://localhost:3000

# Équipe : connexion Google sur /admin, documents gratuits pour ces adresses. Un champ vide = désactivé.
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=
ADMIN_SECRET=

# OCR_PROVIDER=mock  -> texte simulé (tests)

# Lecture des photos (écriture manuscrite) : plusieurs fournisseurs, essayés dans l'ordre.
# Si l'un n'a pas de clé ou tombe en panne / dépasse son quota, on passe au suivant.
OCR_PROVIDERS=gemini,groq,openrouter

# 1. Google Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 2. Groq : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 3. OpenRouter (modèles ":free") : https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free
